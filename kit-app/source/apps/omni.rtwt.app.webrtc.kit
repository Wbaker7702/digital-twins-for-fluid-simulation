# Version lock for all dependencies:
[settings.app.exts]
enabled = [
	"omni.flowusd-106.5.2",
	"omni.graph.action-1.120.0",
	"omni.graph.action_nodes-1.40.1",
	"omni.graph.bundle.action-2.20.0",
	"omni.graph.nodes-1.162.1",
	"omni.graph.scriptnode-1.40.1",
	"omni.graph.ui-1.91.0",
	"omni.graph.ui_nodes-1.40.1",
	"omni.kit.livestream.core-6.1.0",
	"omni.kit.livestream.messaging-1.1.1",
	"omni.kit.livestream.webrtc-6.0.0",
	"omni.kit.sequencer.core-103.4.2",
	"omni.kit.sequencer.usd-103.4.6",
	"omni.kit.streamsdk.plugins-6.2.1",
	"omni.kit.widgets.custom-1.0.9",
